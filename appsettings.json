{
  "OpenAI": {
    "BaseUrl": "https://api.openai.com/v1",
    "GeneratorModel": "gpt-5.4-mini",
    "GeneratorReasoningEffort": "medium",
    "JudgeModel": "gpt-5.4-mini",
    "EmbeddingModel": "text-embedding-3-large",
    "EmbeddingDimensions": 1536,
    "MaxOutputTokens": 700
  },
  "Postgres": {
    "Schema": "search_quality_lab"
  },
  "Benchmark": {
    "TopK": 5,
    "ChunkSizeWords": 450,
    "ChunkOverlapWords": 90,
    "FileSearchChunkSizeTokens": 800,
    "FileSearchChunkOverlapTokens": 400
  },
  "Chat": {
    "ContextTokenBudget": 64000,
    "TopK": 4,
    "DefaultStrategy": "postgres-hybrid",
    "Schema": "chat_lab",
    "Model": "gpt-5.4-mini",
    "Provider": "litellm",
    "Users": [
      { "Id": "ivan", "Name": "Иван" },
      { "Id": "maria", "Name": "Мария" },
      { "Id": "test", "Name": "Тест" }
    ]
  }
}
